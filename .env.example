# Z-English backend environment variables (Vercel project settings)
# Copy to your Vercel project: Project Settings > Environment Variables

# --- Supabase (required) ---
# Project Settings > API in the Supabase dashboard.
SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co
# The SERVICE ROLE key (secret). The serverless API must never leak this to
# the browser — it lives only on the server (Vercel).
SUPABASE_SERVICE_ROLE_KEY=YOUR_SERVICE_ROLE_KEY

# --- Google Gemini (required for the AI tutor / auto-fix / PPTX analyzer) ---
GEMINI_API_KEY=YOUR_GEMINI_API_KEY

# --- Google Sign-In for admins (optional, keeps the Google login button) ---
# Gmail addresses allowed to sign in as admin via Google OAuth.
ADMIN_GOOGLE_EMAILS=z.english.academy26@gmail.com,second.admin@gmail.com

# --- Contact form destination email (optional; if missing, messages are
# stored in the contact_messages table and also emailed when set) ---
CONTACT_DESTINATION_EMAIL=z.english.academy26@gmail.com

# --- Paymob (optional; the frontend already falls back to /api/paymob) ---
PAYMOB_API_KEY=YOUR_PAYMOB_API_KEY
PAYMOB_INTEGRATION_ID=5818041
PAYMOB_IFRAME_ID=1066378
