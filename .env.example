# Z-English backend environment variables (Vercel project settings)
# Copy this file to .env for local dev (`vercel dev`), and add the same values
# to your Vercel project: Project Settings > Environment Variables.
# NEVER commit a real .env file. The service-role key must stay server-only.

# --- Supabase (required) ---
# Project Settings > API in the Supabase dashboard.
SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co
# The SERVICE ROLE key (secret). The serverless API must never leak this to
# the browser — it lives only on the server (Vercel).
SUPABASE_SERVICE_ROLE_KEY=YOUR_SERVICE_ROLE_KEY

# --- Google Gemini (required for the AI tutor / auto-fix / PPTX analyzer / grading) ---
# Create a key at https://aistudio.google.com/apikey (free tier is fine to start).
GEMINI_API_KEY=YOUR_GEMINI_API_KEY
# Optional. Model used for all AI calls. Only change if you know what you're doing.
GEMINI_MODEL=gemini-3.1-flash-lite
# Optional. Model used for text-to-speech audio generation (agentGenerateAudio).
# Uses the same GEMINI_API_KEY. Leave empty to use the default.
GEMINI_TTS_MODEL=gemini-3.1-flash-tts-preview

# --- AI Agent (agentImportAndReview / agentGenerateAudio / corruptAudioScan) ---
# Optional. Max parallel Gemini calls for the agent workers. Default 3.
AGENT_CONCURRENCY=3
# Optional. Max size (bytes) for PPTX files imported from a URL. Default 12MB.
AGENT_MAX_PPTX_BYTES=12582912
# Optional. Output audio format. Only "wav" is supported today (Gemini PCM -> WAV).
AGENT_AUDIO_FORMAT=wav

# --- Google Sign-In for admins (optional) ---
# Gmail addresses allowed to sign in as admin via Google OAuth (comma-separated).
# Replace with your real admin address(es).
ADMIN_GOOGLE_EMAILS=youradmin@gmail.com,second.admin@gmail.com
# The OAuth client ID used by the Google "Continue with Google" button.
# Hardcoded in index.html today; set it here if you want to drive it from env.
GOOGLE_CLIENT_ID=

# --- Contact form destination email (optional) ---
# Where contact messages should be emailed. Messages are always stored in the
# contact_messages table.
CONTACT_DESTINATION_EMAIL=

# --- Paymob (required for the payment-link generator) ---
# All three values are server-side only — never sent from or stored in the browser.
PAYMOB_API_KEY=YOUR_PAYMOB_API_KEY
PAYMOB_INTEGRATION_ID=YOUR_INTEGRATION_ID
PAYMOB_IFRAME_ID=YOUR_IFRAME_ID
